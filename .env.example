# Configuration du serveur
PORT=5000

# MongoDB Atlas - URL de connexion
# Format: mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority
# Remplacez username, password et cluster.mongodb.net par vos valeurs
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/woora-products?retryWrites=true&w=majority

# JWT Secret - Changez cette valeur en production !
# Generer une cle securisable : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_characters

# Duree de validitetoken JWT (7 jours par defaut)
JWT_EXPIRE=7d
